  "events": {
    "event_public_survey": {
      "id": "event_public_survey",
      "type": "public_survey",
      "name": "Public Survey",
      "description": "Citizen opinion and civic feedback survey with 10 default questions and dynamic conversational follow-ups.",
      "language": "te",
      "selectedVoiceProfileId": "Txde0pZ5tVhXE6HUspcf",
      "selectedTemplateId": "tpl_public_amenities",
      "createdAt": "2026-11-13T10:34:22.447Z",
      "updatedAt": "2026-11-15T17:54:26.963Z",
      "config": {
        "surveyIntro": "నమస్కారం అండి! మీ ప్రాంతంలోని ప్రజా సదుపాయాల గురించి కొన్ని విషయాలు తెలుసుకోవడానికి మాట్లాడుతున్నాం.",
        "enableDynamicFollowUps": true,
        "maxFollowUpsPerQuestion": 2,
        "questions": [
          {
            "id": "A1",
            "text": "మీ ప్రాంతంలో తాగునీటి సౌకర్యం ఎలా ఉంది?",
            "category": "తాగునీరు",
            "allowFollowUp": true
          },
          {
            "id": "A2",
            "text": "మీ ప్రాంతంలోని రోడ్ల పరిస్థితి ఎలా ఉంది?",
            "category": "రోడ్లు",
            "allowFollowUp": true
          },
          {
            "id": "A3",
            "text": "మీ ప్రాంతంలో విద్యుత్ సరఫరా ఎలా ఉంది?",
            "category": "విద్యుత్",
            "allowFollowUp": true
          },
          {
            "id": "A4",
            "text": "మీ ప్రాంతంలో డ్రైనేజీ సౌకర్యం గురించి మీ అభిప్రాయం ఏమిటి?",
            "category": "డ్రైనేజీ",
            "allowFollowUp": true
          },
          {
            "id": "A5",
            "text": "మీ ప్రాంతంలో చెత్త సేకరణ మరియు పారిశుధ్య సేవలు ఎలా ఉన్నాయి?",
            "category": "చెత్త సేకరణ & పారిశుధ్యం",
            "allowFollowUp": true
          },
          {
            "id": "A6",
            "text": "మీ ప్రాంతంలో ప్రభుత్వ లేదా స్థానిక ఆరోగ్య సేవలు మీ అవసరాలకు సరిపోతున్నాయా?",
            "category": "ఆరోగ్య సేవలు",
            "allowFollowUp": true
          }
        ]
      },
      "voiceSelectionType": "cloned",
      "selectedVoiceName": "Rishi (Cloned Voice)"
    },
    "event_political_campaign": {
      "id": "event_political_campaign",
      "type": "political_campaign",
      "name": "Political Campaign",
      "description": "Constituency voter outreach with candidate speech scripts and interactive keypad DTMF feedback.",
      "language": "te",
      "selectedVoiceProfileId": "Txde0pZ5tVhXE6HUspcf",
      "selectedTemplateId": "tpl_constituency_outreach",
