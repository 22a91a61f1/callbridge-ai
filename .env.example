# Required Admin Portal Login Credentials (only these 2 values needed for /admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: custom Admin subdomain when you later add a domain (e.g. admin.callbridgeai.com)
ADMIN_HOSTNAME=
APP_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_CREDENTIAL_ID=
OPENAI_API_KEY=
OPENAI_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_ELEVENLABS_CREDENTIAL_ID=
VAPI_MAX_CONCURRENT_CALLS=1
VAPI_PHONE_NUMBER_ID=
VAPI_PRIVATE_API_KEY=
VAPI_PRIVATE_KEY=
VAPI_SECRET=
VAPI_WEBHOOK_SECRET=
# Required for production single-instance JSON storage safety (see hosting configuration)
CALLBRIDGE_DATA_DIR=
CALLBRIDGE_SINGLE_INSTANCE_CONFIRMED=false
CALLBRIDGE_ENFORCE_WEBHOOK_AUTH=